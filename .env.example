# Google Sheets API（団員情報「Member page」同期用）
# 本番・開発で .env.local にコピーし、値を設定してください。.env.local は git に含めないでください。

# サービスアカウントの秘密鍵 JSON をそのまま 1 行で貼り付け（改行は \n に置換するか、複数行の場合は "" で囲む）
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# 対象スプレッドシートの ID（URL の /d/ と /edit の間の文字列）
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# スプレッドシートをサービスアカウントのメール（JSON 内の client_email）と「編集者」で共有してください。
# 「Member page」シートの 1 行目は次のヘッダー（同じ順）にしてください：
# id, name, part, partRank, role, email, status, profile, instagram, isPublic, extraRequestStatus, requestedPracticeIds, instrument, joinYear, attendance
